# Relate LiveKit Voice Stack — Environment Variables
#
# Copy this file and fill in values. NEVER commit the filled-in version.
# All values are set as Coolify runtime environment variables.
#
# See INSTALL.md for generation instructions.

# Deepgram API key (STT + TTS)
# Obtain from: https://console.deepgram.com
DEEPGRAM_API_KEY=

# OpenRouter API key (LLM chain)
# Obtain from: https://openrouter.ai
OPENROUTER_API_KEY=

# LiveKit API key (any random alphanumeric string, 20-30 chars)
# Generate: openssl rand -hex 12
LIVEKIT_API_KEY=

# LiveKit API secret (hex string, 64 chars)
# Generate: openssl rand -hex 32
LIVEKIT_API_SECRET=

# Redis password (hex string, 64 chars)
# Generate: openssl rand -hex 32
REDIS_PASSWORD=

# TURN/STUN credential secret (hex string, 64 chars)
# MUST be the same value used in both coturn and LiveKit config
# Generate: openssl rand -hex 32
TURN_SECRET=

# Web session cookie signing secret (hex string, 64 chars)
# Generate: openssl rand -hex 32
WEB_SESSION_SECRET=
